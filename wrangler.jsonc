{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hertones-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "env": {
    "dev": {
      "name": "hertones-web-dev"
      // dev-specific routes, vars, bindings go here
    },
    "qa": {
      "name": "hertones-web-qa"
      // qa-specific routes, vars, bindings go here
    }
  }
}
